local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PathfindingService = game:GetService("PathfindingService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera
local npc = workspace:WaitForChild("SirYeet")

local STOP_DIST = 5
local FEEL_RANGE = 5
local REPATH_EVERY = 2.5
local JITTER = 0.9

local function getFocusPart()
	return npc:FindFirstChild("Head")
		or npc:FindFirstChild("HumanoidRootPart")
		or npc.PrimaryPart
		or npc:FindFirstChildWhichIsA("BasePart", true)
end

local function getFocusPosition()
	local part = getFocusPart()
	return part and part.Position or npc:GetPivot().Position
end

local highlightOn = true
local camLocked = false
local camDistance = 15
local camAngleX = 20
local camAngleY = 0
local lastMousePos = nil

